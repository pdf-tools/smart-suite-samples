# =============================================================================
# Smart Suite - CPU Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Usage: cp .env.example .env && nano .env
# =============================================================================

# [REQUIRED] Smart Suite license key (legacy Smart Redact keys also work)
# Contact sales for a key: https://www.pdf-tools.com/contact/
# Key format and validation: https://www.pdf-tools.com/docs/licenses/products/smart-suite-license/
PDFTOOLS_LICENSE_KEY=<SMARTST,V1,XXXXXXXXXXXXXXXXXXXX>

# [REQUIRED] File encryption key (AES-256-GCM, 32-byte Base64-encoded)
# Generate with: ../../scripts/generate-encryption-key.sh
ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# [REQUIRED] JWT signing secret for Orchestrator (minimum 32 characters)
# Generate with: openssl rand -base64 64 | tr -d '\n'
ORCHESTRATOR_JWT_SECRET=<minimum-32-character-string>

# [Optional] Image version tags. Smart Suite and the Worker release
# independently, so they are pinned separately; the "latest" tags of the two
# are not a matched pair. Compatibility: https://www.pdf-tools.com/docs/smart-suite/references/version-compatibility/
# VERSION=1.0.0           # Job Manager, Orchestrator, HITL Web UI
# WORKER_VERSION=1.2.0    # Smart Redact Worker

# [Optional] HITL Web UI host port and browser-facing Orchestrator URL
# HITL_WEB_PORT=3000
# HITL_ORCHESTRATOR_URL=http://localhost:9983
