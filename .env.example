# =============================================================================
# Smart Suite - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Licensing [REQUIRED]
# -----------------------------------------------------------------------------
# Your Smart Suite license key (legacy Smart Redact keys also work).
# To get a key or discuss pricing, contact sales: https://www.pdf-tools.com/contact/
# For the key format and how the services validate it, see
# https://www.pdf-tools.com/docs/licenses/products/smart-suite-license/
PDFTOOLS_LICENSE_KEY=<SMARTST,V1,XXXXXXXXXXXXXXXXXXXX>

# -----------------------------------------------------------------------------
# Encryption [REQUIRED]
# -----------------------------------------------------------------------------
# 32-byte Base64-encoded encryption key for file-at-rest encryption (AES-256-GCM).
# Generate one with: ./scripts/generate-encryption-key.sh
ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# -----------------------------------------------------------------------------
# Orchestrator Authentication [REQUIRED if using Orchestrator]
# -----------------------------------------------------------------------------
# JWT signing secret (minimum 32 characters).
# Generate one with: openssl rand -base64 64 | tr -d '\n'
ORCHESTRATOR_JWT_SECRET=<minimum-32-character-string>

# -----------------------------------------------------------------------------
# Image Versions (optional)
# -----------------------------------------------------------------------------
# Smart Suite and each Worker are released independently and have their own
# version numbers, so they are pinned separately. Do not assume the "latest"
# tags of the two match.
#
# VERSION        Job Manager, Orchestrator and HITL Web UI (default: 1.0.0)
# WORKER_VERSION Smart Redact Worker (default: 1.2.0)
#
# For which Worker versions run with which Smart Suite version, see
# https://www.pdf-tools.com/docs/smart-suite/references/version-compatibility/
# VERSION=1.0.0
# WORKER_VERSION=1.2.0

# -----------------------------------------------------------------------------
# HITL Web UI (optional)
# -----------------------------------------------------------------------------
# Host port and browser-facing Orchestrator URL for the human-in-the-loop review UI.
# HITL_WEB_PORT=3000
# HITL_ORCHESTRATOR_URL=http://localhost:9983
