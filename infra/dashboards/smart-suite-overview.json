    },
    {
      "title": "Recent Operations",
      "description": "Detection and redaction operation results from span attributes (Tempo). Click a Trace ID to see the full trace.",
      "type": "table",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 20,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{span.job.type != \"\" && resource.service.name = \"smart-redact-worker\"} | select(span.job.type, span.job.status, span.job.id, span.job.file.id, span.input.file.pages, span.input.file.size_bytes, span.output.entities.count, span.output.file.size_bytes, span.input.entities.count, span.license.consumed.pages, span.failure.reason)",
          "refId": "A",
          "limit": 100
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "spanID": true,
              "rootServiceName": true,
              "rootTraceName": true,
              "traceService": true,
              "traceName": true,
              "traceDuration": true,
              "startTimeUnixNano": true,
              "durationNanos": true,
              "nestedSetLeft": true,
              "nestedSetRight": true,
              "nestedSetParent": true,
              "name": true,
              "kind": true,
              "statusCode": true,
              "statusMessage": true,
              "service.name": true,
              "span.service.name": true
            },
            "indexByName": {
              "job.type": 0,
              "job.status": 1,
              "job.file.id": 2,
              "job.id": 3,
              "input.file.pages": 4,
              "input.file.size_bytes": 5,
              "output.entities.count": 6,
              "license.consumed.pages": 7,
              "output.file.size_bytes": 8,
              "input.entities.count": 9,
              "start time": 10,
              "duration": 11,
              "failure.reason": 12,
              "traceID": 13
            },
            "renameByName": {
              "job.type": "Type",
              "job.status": "Status",
              "job.file.id": "File ID",
              "job.id": "Job ID",
              "input.file.pages": "Pages",
              "input.file.size_bytes": "Input Size",
              "input.entities.count": "Input Entities",
              "output.file.size_bytes": "Output Size",
              "output.entities.count": "Entities",
              "license.consumed.pages": "Consumed",
              "start time": "Start Time",
              "duration": "Duration",
              "failure.reason": "Failure Reason",
              "traceID": "Trace ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "detection": {
                        "color": "blue",
                        "index": 0,
                        "text": "detection"
                      },
                      "redaction": {
                        "color": "orange",
                        "index": 1,
                        "text": "redaction"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Finished": {
                        "color": "green",
                        "index": 0,
                        "text": "Finished"
                      },
                      "Error": {
                        "color": "red",
                        "index": 1,
                        "text": "Error"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Det. Pages"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Red. Pages"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace",
                    "url": "/explore?orgId=1&left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "smart-redact",
    "opentelemetry"
  ],
  "time": {
